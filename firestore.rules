rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Identidad ──────────────────────────────────────────────────────────
    // Tener sesión de Firebase Auth NO basta: cualquiera puede crear una cuenta de
    // Google o email/password contra este proyecto. Todo acceso a datos exige estar
    // en la lista blanca (usuarios_permitidos), activo y con email verificado (si no,
    // alguien podría registrarse con email/password usando el correo de otro).

    function isSignedIn() {
      return request.auth != null;
    }

    function permisoPath() {
      return /databases/$(database)/documents/usuarios_permitidos/$(request.auth.token.email);
    }

    function isUsuarioActivo() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        exists(permisoPath()) &&
        get(permisoPath()).data.activo == true;
    }

    function isGlobalAdmin() {
      return isUsuarioActivo() && get(permisoPath()).data.rol == 'admin';
    }

    // ─── Empresas y proyectos ───────────────────────────────────────────────

    // Acceso a una empresa: miembro en empresa.miembros, o la empresa está asignada
    // en su usuarios_permitidos.empresas (no depende de que miembros esté sincronizado)
    function isMiembroEmpresa(empresaId) {
      return (exists(/databases/$(database)/documents/empresas/$(empresaId)) &&
              request.auth.uid in get(/databases/$(database)/documents/empresas/$(empresaId)).data.miembros) ||
             empresaId in get(permisoPath()).data.empresas;
    }

    function puedeEditarEmpresa(empresaId) {
      return exists(/databases/$(database)/documents/empresas/$(empresaId)) &&
        get(/databases/$(database)/documents/empresas/$(empresaId)).data.miembros[request.auth.uid] in ['owner', 'admin'];
    }

    function proyectoPath(proyectoId) {
      return /databases/$(database)/documents/proyectos/$(proyectoId);
    }

    // Equipo del proyecto: miembro directo (proyecto compartido) o miembro de su empresa
    function puedeVerProyecto(proyectoId) {
      return exists(proyectoPath(proyectoId)) && (
        request.auth.uid in get(proyectoPath(proyectoId)).data.miembros ||
        isMiembroEmpresa(get(proyectoPath(proyectoId)).data.empresaId)
      );
    }

    function puedeVerTarea(tareaId) {
      let tarea = /databases/$(database)/documents/tareas/$(tareaId);
      return exists(tarea) && puedeVerProyecto(get(tarea).data.proyectoId);
    }

    // ─── Usuarios ───────────────────────────────────────────────────────────

    // Lista blanca. Cada quien lee su propio permiso (lo necesita el login antes de
    // estar validado); el resto del equipo puede listarla para compartir proyectos.
    // Solo admins globales la modifican, salvo proyectosCompartidos (compartir proyecto).
    match /usuarios_permitidos/{email} {
      allow get: if isSignedIn() && request.auth.token.email == email;
      allow read: if isUsuarioActivo();
      allow create, delete: if isGlobalAdmin();
      allow update: if isGlobalAdmin() || (
        isUsuarioActivo() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proyectosCompartidos'])
      );
    }

    match /usuarios/{uid} {
      allow read: if isUsuarioActivo();
      allow write: if isUsuarioActivo() && (request.auth.uid == uid || isGlobalAdmin());
    }

    // Configuración de email (contiene App Password de Gmail y API key) — solo el dueño
    match /email_config/{uid} {
      allow read: if isUsuarioActivo() && request.auth.uid == uid;
      allow write: if isUsuarioActivo() && request.auth.uid == uid &&
        request.resource.data.uid == uid;
    }

    // Notificaciones in-app; cada quien ve las suyas. Las crea el portal del cliente al
    // enviar una solicitud de cambio: solo para dueños del proyecto y en el mismo batch
    // que crea esa solicitud (no se pueden fabricar notificaciones sueltas).
    function notificacionDeSolicitudValida() {
      let n = request.resource.data;
      return n.keys().hasOnly(['uid', 'tipo', 'proyectoId', 'empresaId', 'portalToken',
                               'solicitudId', 'titulo', 'mensaje', 'leida', 'creadoEn']) &&
        n.tipo == 'solicitud_cambio' &&
        n.portalToken is string && portalActivo(n.portalToken) &&
        n.uid in get(portalPath(n.portalToken)).data.duenos &&
        n.proyectoId == get(portalPath(n.portalToken)).data.proyectoId &&
        n.solicitudId is string &&
        !exists(/databases/$(database)/documents/portales/$(n.portalToken)/solicitudes/$(n.solicitudId)) &&
        existsAfter(/databases/$(database)/documents/portales/$(n.portalToken)/solicitudes/$(n.solicitudId)) &&
        escrituraPublicaSellada(n.portalToken) &&
        textoValido(n.titulo, 200) && textoValido(n.mensaje, 300) &&
        n.leida == false && n.creadoEn == request.time;
    }
    match /notificaciones/{nId} {
      allow read: if isUsuarioActivo() && resource.data.uid == request.auth.uid;
      allow create: if notificacionDeSolicitudValida();
      allow update: if isUsuarioActivo() && resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow delete: if isUsuarioActivo() && resource.data.uid == request.auth.uid;
    }

    // ─── Empresas ───────────────────────────────────────────────────────────

    match /empresas/{empresaId} {
      allow read: if isUsuarioActivo() && (
        request.auth.uid in resource.data.miembros ||
        empresaId in get(permisoPath()).data.empresas
      );
      allow create: if isUsuarioActivo() &&
        request.resource.data.miembros[request.auth.uid] == 'owner';
      allow update: if isUsuarioActivo() && resource.data.miembros[request.auth.uid] in ['owner', 'admin'];
      allow delete: if isUsuarioActivo() && resource.data.miembros[request.auth.uid] == 'owner';
    }

    match /clientes/{cId} {
      allow read: if isUsuarioActivo() && isMiembroEmpresa(resource.data.empresaId);
      allow create: if isUsuarioActivo() && puedeEditarEmpresa(request.resource.data.empresaId);
      allow update: if isUsuarioActivo() && puedeEditarEmpresa(resource.data.empresaId) &&
        request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if isUsuarioActivo() && puedeEditarEmpresa(resource.data.empresaId);
    }

    match /invitaciones/{invId} {
      allow read: if isUsuarioActivo() && (
        resource.data.emailDestino == request.auth.token.email ||
        resource.data.creadoPor == request.auth.uid
      );
      allow create: if isUsuarioActivo() && puedeEditarEmpresa(request.resource.data.empresaId);
      allow update: if isUsuarioActivo() && resource.data.emailDestino == request.auth.token.email;
    }

    // ─── Proyectos ──────────────────────────────────────────────────────────
    // Queries de la app: where('empresaId', '==' | 'in', …) y where(documentId(), 'in', ids)
    match /proyectos/{proyectoId} {
      allow read: if isUsuarioActivo() && (
        request.auth.uid in resource.data.miembros ||
        isMiembroEmpresa(resource.data.empresaId)
      );
      allow create: if isUsuarioActivo() && puedeEditarEmpresa(request.resource.data.empresaId);
      allow update: if isUsuarioActivo() && puedeEditarEmpresa(resource.data.empresaId) &&
        request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if isUsuarioActivo() && puedeEditarEmpresa(resource.data.empresaId);
    }

    // ─── Tareas ─────────────────────────────────────────────────────────────
    // Queries de la app: where('proyectoId', '==' | 'in', …) y where('empresaId', 'in', …)
    match /tareas/{tareaId} {
      allow read: if isUsuarioActivo() && (
        isMiembroEmpresa(resource.data.empresaId) ||
        puedeVerProyecto(resource.data.proyectoId)
      );
      // La tarea debe pertenecer a la misma empresa que su proyecto
      allow create: if isUsuarioActivo() &&
        puedeVerProyecto(request.resource.data.proyectoId) &&
        request.resource.data.empresaId == get(proyectoPath(request.resource.data.proyectoId)).data.empresaId;
      allow update: if isUsuarioActivo() &&
        puedeVerProyecto(resource.data.proyectoId) &&
        request.resource.data.proyectoId == resource.data.proyectoId &&
        request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if isUsuarioActivo() && puedeEditarEmpresa(resource.data.empresaId);
    }

    // Comentarios de tareas — query: where('tareaId', '==', …)
    match /comentarios/{cId} {
      allow read: if isUsuarioActivo() && puedeVerTarea(resource.data.tareaId);
      allow create: if isUsuarioActivo() &&
        request.resource.data.autorId == request.auth.uid &&
        puedeVerTarea(request.resource.data.tareaId);
      allow delete: if isUsuarioActivo() && resource.data.autorId == request.auth.uid;
    }

    // Historial de cambios — query: where('tareaId', '==', …). Inmutable.
    match /historial_cambios/{hId} {
      allow read: if isUsuarioActivo() && puedeVerTarea(resource.data.tareaId);
      allow create: if isUsuarioActivo() && puedeVerTarea(request.resource.data.tareaId);
    }

    // Líneas base — query: where('proyectoId', '==', …)
    match /lineas_base/{lbId} {
      allow read: if isUsuarioActivo() && puedeVerProyecto(resource.data.proyectoId);
      allow create: if isUsuarioActivo() && puedeVerProyecto(request.resource.data.proyectoId);
      allow update, delete: if isUsuarioActivo() && puedeVerProyecto(resource.data.proyectoId);
    }

    // Plantillas — query: where('empresaId', '==', …)
    match /plantillas/{pId} {
      allow read: if isUsuarioActivo() && isMiembroEmpresa(resource.data.empresaId);
      allow create: if isUsuarioActivo() && puedeEditarEmpresa(request.resource.data.empresaId);
      allow delete: if isUsuarioActivo() && puedeEditarEmpresa(resource.data.empresaId);
    }

    // ─── Portales de cliente ────────────────────────────────────────────────
    // El cliente (sin cuenta) NO lee proyectos ni tareas. El equipo publica en
    // portales/{token}.publico una copia filtrada; el cliente solo puede hacer `get` de
    // su portal (no `list`: los tokens no se pueden enumerar) mientras esté activo.
    // Sus escrituras (aprobar, comentar, solicitar) van en un batch que sella
    // ultimaEscrituraPublica = request.time, con mínimo 3 s entre escrituras (anti-spam).

    function portalPath(token) {
      return /databases/$(database)/documents/portales/$(token);
    }

    function portalActivo(token) {
      return exists(portalPath(token)) && get(portalPath(token)).data.activo == true;
    }

    function equipoDelPortal(token) {
      return isUsuarioActivo() && puedeVerProyecto(get(portalPath(token)).data.proyectoId);
    }

    function escrituraPublicaSellada(token) {
      return getAfter(portalPath(token)).data.ultimaEscrituraPublica == request.time;
    }

    function textoValido(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    match /portales/{token} {
      allow get: if resource.data.activo == true ||
        (isUsuarioActivo() && puedeVerProyecto(resource.data.proyectoId));
      allow list: if isUsuarioActivo() && puedeVerProyecto(resource.data.proyectoId);
      allow create: if isUsuarioActivo() &&
        puedeVerProyecto(request.resource.data.proyectoId) &&
        request.resource.data.activo == true;
      allow update: if
        (isUsuarioActivo() &&
         puedeVerProyecto(resource.data.proyectoId) &&
         request.resource.data.proyectoId == resource.data.proyectoId) ||
        // Sello anti-spam del cliente: solo ese campo, con la hora del servidor, cada ≥ 3 s
        (resource.data.activo == true &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimaEscrituraPublica']) &&
         request.resource.data.ultimaEscrituraPublica == request.time &&
         (!('ultimaEscrituraPublica' in resource.data) ||
          request.time > resource.data.ultimaEscrituraPublica + duration.value(3, 's')));
      allow delete: if isUsuarioActivo() && puedeVerProyecto(resource.data.proyectoId);

      // Aprobación: solo hitos completados que pertenezcan al proyecto del portal
      match /aprobaciones/{hitoId} {
        allow read: if portalActivo(token) || equipoDelPortal(token);
        allow create: if portalActivo(token) && escrituraPublicaSellada(token) &&
          request.resource.data.keys().hasOnly(['hitoId', 'nombre', 'aprobadoEn']) &&
          request.resource.data.hitoId == hitoId &&
          textoValido(request.resource.data.nombre, 100) &&
          request.resource.data.aprobadoEn == request.time &&
          get(/databases/$(database)/documents/tareas/$(hitoId)).data.proyectoId == get(portalPath(token)).data.proyectoId &&
          get(/databases/$(database)/documents/tareas/$(hitoId)).data.tipo == 'hito' &&
          get(/databases/$(database)/documents/tareas/$(hitoId)).data.estado == 'completada';
        allow update, delete: if equipoDelPortal(token);
      }

      match /comentarios/{cId} {
        allow read: if portalActivo(token) || equipoDelPortal(token);
        allow create: if portalActivo(token) && escrituraPublicaSellada(token) &&
          request.resource.data.keys().hasOnly(['texto', 'autor', 'creadoEn']) &&
          textoValido(request.resource.data.texto, 2000) &&
          textoValido(request.resource.data.autor, 100) &&
          request.resource.data.creadoEn == request.time;
        allow update, delete: if equipoDelPortal(token);
      }

      // Solicitudes de cambio: el cliente crea, solo el equipo las lee
      match /solicitudes/{sId} {
        allow create: if portalActivo(token) && escrituraPublicaSellada(token) &&
          request.resource.data.keys().hasOnly(['descripcion', 'autor', 'creadoEn', 'estado']) &&
          textoValido(request.resource.data.descripcion, 4000) &&
          textoValido(request.resource.data.autor, 100) &&
          request.resource.data.creadoEn == request.time &&
          request.resource.data.estado == 'pendiente';
        allow read, update, delete: if equipoDelPortal(token);
      }
    }
  }
}
